        android:layout_width="244dp"
        android:layout_height="140dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:background="@drawable/c1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="230dp"
        android:layout_height="142dp"
        android:layout_marginTop="-35dp"
        android:layout_marginEnd="224dp"
        android:background="@drawable/c2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title Section -->
    <LinearLayout
        android:id="@+id/titleSection"
        android:layout_width="321dp"
        android:layout_height="85dp"
        android:layout_marginTop="30dp"

        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Image View (Logo or Icon) -->
        <ImageView
            android:id="@+id/pageIcon"
            android:layout_width="82dp"
            android:layout_height="69dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Page Icon"
            android:src="@drawable/calander" />

        <!-- Title TextView -->
        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plan Your Month"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable months list -->
    <ScrollView
        android:layout_width="354dp"
        android:layout_height="616dp"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


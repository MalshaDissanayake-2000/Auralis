                        <LinearLayout
                            android:id="@+id/textContainer11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="November"
                                android:textColor="@android:color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="November gathers us with gratitude and peace."
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:textStyle="italic" />
                        </LinearLayout>

                        <!-- Open button on right side -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNovember"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:backgroundTint="@color/secondary_color"
                            android:text="Open"
                            android:textColor="@android:color/white"
                            app:cornerRadius="8dp" />
                    </RelativeLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>


            <!-- December Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Background image for month -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="December"
                        android:scaleType="centerCrop"
                        android:src="@drawable/m12" />

                    <!-- Overlay -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@color/m_purple"
                        android:padding="12dp">

                        <!-- Left side text -->
                        <LinearLayout
                            android:id="@+id/textContainer12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="December"
                                android:textColor="@android:color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="December shines with lights, love, and cheer."
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:textStyle="italic" />
                        </LinearLayout>

                        <!-- Open button on right side -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDecember"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:backgroundTint="@color/secondary_color"
                            android:text="Open"
                            android:textColor="@android:color/white"
                            app:cornerRadius="8dp" />
                    </RelativeLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>


            <!-- Repeat for March → December with ids: btnMarch, btnApril, ... btnDecember -->
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/light_purple"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

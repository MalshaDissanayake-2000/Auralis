<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homePage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_color"
    tools:context=".MainActivity">

    <!-- Top Section with Image + "Hi Malsha" -->
    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/secondary_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/homeIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_profile"
            android:contentDescription="Home Icon"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hi"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="italic"/>
    </LinearLayout>

    <!-- Scrollable Section -->
    <ScrollView
        android:id="@+id/scrollHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/homeHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationHome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Your Journal Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yourjournal"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_color"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Months Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:id="@+id/month"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/monthsh">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/monthsh"
                            android:contentDescription="Months"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/months"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- About Me Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/aboutme">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/aboutme"
                            android:contentDescription="About Me"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/aboutme"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- Vision Board Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/visionboard">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/visionboard"
                            android:contentDescription="Vision Board"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/visionboard"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- Memories Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/memories">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/memories"
                            android:contentDescription="Memories"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/memories"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- Wish List Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/wish">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/wish"
                            android:contentDescription="Wish List"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wishlist"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- Bucket List Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bucketlist">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bucketlist"
                            android:contentDescription="Bucket List"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bucketlist"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- Mandela Art Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/mandala">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/mandala"
                            android:contentDescription="Mandela Art"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mandelaart"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- Goals Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/goals">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/gooals"
                            android:contentDescription="goals"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/goals"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- Movie Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/movie">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/movie"
                            android:contentDescription="Movie"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/movie"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                    <!-- Books Card -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/books">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/books"
                            android:contentDescription="Books"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/books"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#66000000"
                            android:layout_gravity="bottom"/>
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>




            <!-- Quick Note Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:background="@color/p_tips">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@color/primary_color"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="379dp"
                        android:layout_height="134dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/note"
                        android:text="@string/quicknote"
                        android:textColor="@color/secondary_color"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/quickNoteEditText"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:hint="Write something here..."
                        android:textColor="@color/black"
                        android:textColorHint="#80000000"
                        android:gravity="top"
                        android:padding="8dp"
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- Mood Tracker Title -->

            <!-- Horizontal scrollable Mood Cards -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- New Multi-Image Card (Before Happy) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="200dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        android:background="@color/p_tips">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:gravity="center"
                            android:background="@color/h_purple">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center">


                                <ImageView
                                    android:layout_width="45dp"
                                    android:layout_height="45dp"
                                    android:src="@drawable/happy"
                                    android:contentDescription="Icon 2"
                                    android:layout_margin="2dp"/>

                                <ImageView
                                    android:layout_width="45dp"
                                    android:layout_height="45dp"
                                    android:src="@drawable/sad"
                                    android:contentDescription="Icon 3"
                                    android:layout_margin="2dp"/>

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/angry"
                                    android:contentDescription="Icon 1"
                                    android:layout_margin="2dp"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="45dp"
                                    android:layout_height="45dp"
                                    android:src="@drawable/excitedee"
                                    android:contentDescription="Icon 4"
                                    android:layout_margin="2dp"/>

                                <ImageView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:src="@drawable/calm"
                                    android:contentDescription="Icon 5"
                                    android:layout_margin="2dp"/>
                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/stressed"
                                    android:contentDescription="Icon 5"
                                    android:layout_margin="2dp"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/main1"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold|italic" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/main2"
                                android:textColor="@color/secondary_color"
                                android:textSize="16sp"
                                android:textStyle="bold|italic" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Happy Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        android:background="@color/p_tips">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:background="@color/h_purple"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="83dp"
                                android:layout_height="77dp"
                                android:contentDescription="Happy"
                                android:src="@drawable/happy" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/happy"
                                android:textColor="@color/secondary_color"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Somthing  made you smile today"
                                android:textAlignment="center"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold|italic" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <!-- Sad Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        android:background="@color/p_tips">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:background="@color/h_purple"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="83dp"
                                android:layout_height="77dp"
                                android:contentDescription="Happy"
                                android:src="@drawable/sad" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/sad"
                                android:textColor="@color/secondary_color"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/main3"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold|italic" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Excite Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        android:background="@color/p_tips">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:background="@color/h_purple"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="83dp"
                                android:layout_height="77dp"
                                android:contentDescription="Happy"
                                android:src="@drawable/excitedee" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Excite"
                                android:textColor="@color/secondary_color"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Writing can calm the noise..."
                                android:textAlignment="center"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold|italic" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Angry Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        android:background="@color/p_tips">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:background="@color/h_purple"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="83dp"
                                android:layout_height="77dp"
                                android:contentDescription="Happy"
                                android:src="@drawable/angry" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Angry"
                                android:textColor="@color/secondary_color"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Get it out on the page"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold|italic" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <!-- (Rest of your mood cards go here...) -->

                </LinearLayout>
            </HorizontalScrollView>


            <!-- Bottom Highlight Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:background="@color/p_tips">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/primary_color"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/bottomImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Bottom Image"
                        android:background="@drawable/pi01"/>

                    <Button
                        android:id="@+id/bottomButton"
                        android:layout_width="151dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/secondary_color"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="Start"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/bottomText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="16dp"
                        android:text="Start Your Amazing Journy "
                        android:textColor="@color/white"
                        android:textIsSelectable="true"
                        android:textSize="24sp"
                        android:textStyle="bold|italic" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>




    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/light_purple"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
